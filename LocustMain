local sb=button("SprintButton","SPRINT: OFF")
local cb=button("CrouchButton","CROUCH: OFF")

local function updateButtons()
 sb.Text=sprinting and "SPRINT: ON" or "SPRINT: OFF"

 sb.BackgroundColor3=
  sprinting
  and Color3.fromRGB(40,120,40)
  or Color3.fromRGB(20,20,20)

 cb.Text=crouching and "CROUCH: ON" or "CROUCH: OFF"

 cb.BackgroundColor3=
  crouching
  and Color3.fromRGB(120,80,20)
  or Color3.fromRGB(20,20,20)
end

sb.Activated:Connect(function()
 setSprint(not sprinting)
 updateButtons()
end)

cb.Activated:Connect(function()
 setCrouch(not crouching)
 updateButtons()
end)

UIS.InputBegan:Connect(function(i,gp)
 if gp then
  return
 end

 if i.KeyCode==Enum.KeyCode.LeftShift
 or i.KeyCode==Enum.KeyCode.RightShift then

  setSprint(true)
  updateButtons()

 elseif i.KeyCode==Enum.KeyCode.C
 or i.KeyCode==Enum.KeyCode.LeftControl then

  setCrouch(not crouching)
  updateButtons()
 end
end)

UIS.InputEnded:Connect(function(i)
 if i.KeyCode==Enum.KeyCode.LeftShift
 or i.KeyCode==Enum.KeyCode.RightShift then

  setSprint(false)
  updateButtons()
 end
end)

local themeSound

local function getSound()
 if not isfile(musicFile) then
  local x=game:HttpGet(musicURL)

  if not x or #x==0 then
   return nil
  end

  writefile(musicFile,x)
 end

 local s=Instance.new("Sound")
 s.Name="LocustTheme"
 s.SoundId=getcustomasset(musicFile)
 s.Volume=.7
 s.Looped=true
 s.Parent=SoundService

 return s
end

task.spawn(function()
 while task.wait(.5) do

  if workspace:FindFirstChild("Locust") then

   if not themeSound then
    themeSound=getSound()
   end

   if themeSound and not themeSound.IsPlaying then
    themeSound:Play()
   end

  elseif themeSound then

   themeSound:Destroy()
   themeSound=nil

  end
 end
end)

applyMovement()
updateAnim()
updateButtons()

