local IdleKS=animations:FindFirstChild("Idle")
local WalkKS=animations:FindFirstChild("Walk")
local SprintKS=animations:FindFirstChild("Sprint")
local CrouchKS=animations:FindFirstChild("Crouch")
local CrouchWalkKS=animations:FindFirstChild("CrouchWalk")

local function stopAnim()
 local t=currentTrack

 currentTrack=nil
 currentName=nil

 if t then
  pcall(function()
   if t.Stop then
    t:Stop()
   end
  end)

  pcall(function()
   if t.RestoreAnimator then
    t:RestoreAnimator()
   end
  end)
 end
end

local function playAnim(name,seq)
 if not seq then
  return
 end

 if currentName==name and currentTrack then
  return
 end

 stopAnim()

 currentName=name

 local ok,t=pcall(function()
  return PlayKeyframeSequence(
   locust,
   seq,
   ANIMSPEED
  )
 end)

 if ok then
  currentTrack=t
 end
end

local function applyMovement()
 if not h or h.Health<=0 then
  return
 end

 local speed

 if crouching then
  speed=CROUCH
 elseif sprinting then
  speed=SPRINT
 else
  speed=NORMAL
 end

 h.WalkSpeed=speed

 local dir=h.MoveDirection

 if dir.Magnitude>.01 then
  local v=r.AssemblyLinearVelocity

  r.AssemblyLinearVelocity=Vector3.new(
   dir.X*speed,
   v.Y,
   dir.Z*speed
  )
 end
end

local function updateAnim()
 local moving=h.MoveDirection.Magnitude>.05
 local state

 if crouching then
  if moving then
   state="CrouchWalk"
  else
   state="Crouch"
  end
 elseif sprinting and moving then
  state="Sprint"
 elseif moving then
  state="Walk"
 else
  state="Idle"
 end

 if state==lastState then
  return
 end

 lastState=state

 if state=="Crouch" then
  playAnim("Crouch",CrouchKS)

 elseif state=="CrouchWalk" then
  playAnim("CrouchWalk",CrouchWalkKS)

 elseif state=="Sprint" then
  playAnim("Sprint",SprintKS)

 elseif state=="Walk" then
  playAnim("Walk",WalkKS)

 else
  playAnim("Idle",IdleKS)
 end
end

local function setCrouch(v)
 crouching=v
 lastState=""
 stopAnim()
 applyMovement()
 updateAnim()
end

local function setSprint(v)
 sprinting=v

 if crouching then
  lastState=""
  updateAnim()
 else
  lastState=""
  stopAnim()
  applyMovement()
  updateAnim()
 end
end

