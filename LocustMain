  local x=game:HttpGet(musicURL)

  if not x or #x==0 then
   return nil
  end

  writefile(musicFile,x)
 end

 local s=Instance.new("Sound")
 s.Name="LocustTheme"
 s.SoundId=getcustomasset(musicFile)
 s.Volume=.7
 s.Looped=true
 s.Parent=SoundService

 return s
end

task.spawn(function()

 while task.wait(.5) do

  if workspace:FindFirstChild("Locust") then

   if not themeSound then
    themeSound=getSound()
   end

   if themeSound and not themeSound.IsPlaying then
    themeSound:Play()
   end

  elseif themeSound then

   themeSound:Destroy()
   themeSound=nil

  end
 end
end)

