local function hide(v)
 if v:IsA("BasePart") then
  v.LocalTransparencyModifier=1
 elseif v:IsA("Decal") or v:IsA("Texture") then
  v.Transparency=1
 elseif v:IsA("ParticleEmitter")
 or v:IsA("Trail")
 or v:IsA("Beam") then
  v.Enabled=false
 end
end

