local function getLocustHead()
 local l=workspace:FindFirstChild("Locust")
 if not l then return nil end

 local o=l:FindFirstChild("Objects")
 if not o then return nil end

 local s=o:FindFirstChild("StarterCharacter")
 if not s then return nil end

 return s:FindFirstChild("Head",true)
end

local function startCamera()
 local head=getLocustHead()
 if not head then return end

 if not cameraFollowing then
  savedCameraSubject=camera.CameraSubject
  savedCameraType=camera.CameraType
 end

 cameraFollowing=true
 camera.CameraType=Enum.CameraType.Scriptable

 if cameraReturnConnection then
  cameraReturnConnection:Disconnect()
  cameraReturnConnection=nil
 end

 if cameraConnection then
  cameraConnection:Disconnect()
 end

 cameraConnection=RunService.RenderStepped:Connect(function()
  if not cameraFollowing then return end
  if not head or not head.Parent then return end

  local target=CFrame.lookAt(
   head.Position+Vector3.new(0,2.5,7),
   head.Position+Vector3.new(0,1.5,0)
  )

  camera.CFrame=camera.CFrame:Lerp(
   target,
   CAMERA_SPEED
  )
 end)
end

local function stopCamera()
 if not cameraFollowing then return end

 cameraFollowing=false

 if cameraConnection then
  cameraConnection:Disconnect()
  cameraConnection=nil
 end

 local subject=savedCameraSubject

 if not subject or not subject.Parent then
  subject=h
 end

 local rootPart=r

 local target=CFrame.lookAt(
  rootPart.Position+Vector3.new(0,2.5,7),
  rootPart.Position+Vector3.new(0,1.5,0)
 )

 local start=camera.CFrame
 local elapsed=0

 camera.CameraType=Enum.CameraType.Scriptable

 if cameraReturnConnection then
  cameraReturnConnection:Disconnect()
 end

 cameraReturnConnection=RunService.RenderStepped:Connect(function(dt)
  elapsed+=dt

  local a=math.clamp(
   elapsed/CAMERA_RETURN,
   0,
   1
  )

  a=a*a*(3-2*a)

  camera.CFrame=start:Lerp(
   target,
   a
  )

  if a>=1 then
   cameraReturnConnection:Disconnect()
   cameraReturnConnection=nil

   camera.CameraType=savedCameraType or Enum.CameraType.Custom
   camera.CameraSubject=subject
  end
 end)
end

local function fadeIn(t)
 pcall(function()
  if t.AdjustWeight then
   t:AdjustWeight(0,0)
   t:AdjustWeight(1,FADE)
  end
 end)
end

local function fadeOut(t)
 pcall(function()
  if t.AdjustWeight then
   t:AdjustWeight(0,FADE)
  end
 end)
end

local function stopAnim()
 local t=currentTrack

 currentTrack=nil
 currentName=nil

 if t then
  fadeOut(t)

  task.delay(FADE,function()
   pcall(function()
    if t.Stop then
     t:Stop()
    end
   end)

   pcall(function()
    if t.RestoreAnimator then
     t:RestoreAnimator()
    end
   end)
  end)
 end
end

local function playAnim(name,seq)
 if not seq then return end
 if currentName==name and currentTrack then return end

 local previous=currentTrack

 if previous then
  fadeOut(previous)

  task.delay(FADE,function()
   pcall(function()
    if previous.Stop then
     previous:Stop()
    end
   end)

   pcall(function()
    if previous.RestoreAnimator then
     previous:RestoreAnimator()
    end
   end)
  end)
 end

 currentName=name

 local ok,t=pcall(function()
  return PlayKeyframeSequence(
   locust,
   seq,
   ANIMSPEED
  )
 end)

 if ok and t then
  currentTrack=t
  fadeIn(t)
 end
end

local function applyMovement()
 if not h or h.Health<=0 then return end

 local speed

 if sitting or spawning then
  speed=0
 elseif crouching then
  speed=CROUCH
 elseif sprinting then
  speed=SPRINT
 else
  speed=WALK
 end

 h.WalkSpeed=speed

 if sitting or spawning then
  h:Move(Vector3.zero,false)
  r.AssemblyLinearVelocity=Vector3.zero
  return
 end

 local dir=h.MoveDirection

 if dir.Magnitude>.01 then
  local v=r.AssemblyLinearVelocity

  r.AssemblyLinearVelocity=Vector3.new(
   dir.X*speed,
   v.Y,
   dir.Z*speed
  )
 end
end

local function updateAnim()
 if spawning then return end

 if sitting then
  if currentName~="Sit" then
   playAnim("Sit",SitKS)
  end
  return
 end

 local moving=h.MoveDirection.Magnitude>.05
 local state

 if crouching then
  state=moving and "WalkCrouch" or "IdleCrouch"
 elseif sprinting and moving then
  state="Sprint"
 elseif moving then
  state="Walk"
 else
  state="Idle"
 end

 if state==lastState then return end

 lastState=state

 if state=="IdleCrouch" then
  playAnim("IdleCrouch",IdleCrouchKS)
 elseif state=="WalkCrouch" then
  playAnim("WalkCrouch",WalkCrouchKS)
 elseif state=="Sprint" then
  playAnim("Sprint",SprintKS)
 elseif state=="Walk" then
  playAnim("Walk",WalkKS)
 else
  playAnim("Idle",IdleKS)
 end
end

local function setCrouch(v)
 if sitting or spawning then return end

 crouching=v
 lastState=""

 if crouching then
  startCamera()
 else
  stopCamera()
 end

 stopAnim()
 applyMovement()
 updateAnim()
end

local function setSprint(v)
 if sitting or spawning then return end

 sprinting=v
 lastState=""

 stopAnim()
 applyMovement()
 updateAnim()
end

local function setSit(v)
 if spawning then return end

 sitting=v

 if sitting then
  sprinting=false
  crouching=false
  lastState=""

  startCamera()

  stopAnim()

  h.WalkSpeed=0
  h:Move(Vector3.zero,false)
  r.AssemblyLinearVelocity=Vector3.zero

  task.delay(FADE,function()
   if sitting and not spawning then
    playAnim("Sit",SitKS)
   end
  end)
 else
  stopAnim()
  stopCamera()

  h.WalkSpeed=WALK
  r.AssemblyLinearVelocity=Vector3.zero

  lastState=""
  applyMovement()
  updateAnim()
 end
end

local function playSpawn()
 if spawning or not SpawnKS then return end

 spawning=true
 sitting=false
 crouching=false
 sprinting=false
 lastState="Spawn"

 startCamera()

 stopAnim()

 h.WalkSpeed=0
 h:Move(Vector3.zero,false)
 r.AssemblyLinearVelocity=Vector3.zero

 task.delay(FADE,function()

  if not spawning then return end

  local ok,track=pcall(function()
   return PlayKeyframeSequence(
    locust,
    SpawnKS,
    ANIMSPEED
   )
  end)

  if not ok or not track then
   spawning=false
   currentTrack=nil
   currentName=nil
   lastState=""

   stopCamera()
   applyMovement()
   updateAnim()

   return
  end

  currentTrack=track
  currentName="Spawn"

  fadeIn(track)

  pcall(function()
   track.Looped=false
  end)

  task.spawn(function()

   repeat
    task.wait()
   until currentTrack~=track
   or not track.IsPlaying

   if currentTrack==track then

    fadeOut(track)
    task.wait(FADE)

    currentTrack=nil
    currentName=nil
    spawning=false
    lastState=""

    h.WalkSpeed=WALK
    r.AssemblyLinearVelocity=Vector3.zero

    stopCamera()

    applyMovement()
    updateAnim()
   end
  end)
 end)
end

